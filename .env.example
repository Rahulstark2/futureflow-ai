# Gemini API Key (Required for AI Pipeline)
GEMINI_API_KEY=your-gemini-api-key-here
# Choose any Gemini model (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro, etc.)
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# Database Configuration (Docker defaults)
POSTGRES_USER=futureflow
POSTGRES_PASSWORD=futureflow_secret
POSTGRES_DB=futureflow
POSTGRES_PORT=5432

# Application Port
PORT=4000
